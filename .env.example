# Postgres connection string (Supabase → Project Settings → Database → Connection string → URI).
# Use the pooled connection (port 6543) for serverless.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Clinic passcode gate
MEDSPACE_PASSCODE="choose-a-passcode"
# Front-desk passcode — opens ONLY the /queue screen (no clinical records).
# Must differ from MEDSPACE_PASSCODE; unset = staff login disabled.
MEDSPACE_STAFF_PASSCODE="choose-a-different-passcode"
MEDSPACE_SESSION_SECRET="64-hex-chars-from-openssl-rand-hex-32"

# Signs the patient links sent over WhatsApp (openssl rand -hex 32)
MEDSPACE_PATIENT_LINK_SECRET="64-hex-chars"

# Supabase as a Google identity provider only (never a data API). The
# publishable key is public by design; RLS is deny-all so it can read nothing.
MEDSPACE_SUPABASE_URL="https://PROJECT_REF.supabase.co"
MEDSPACE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Absolute origin Google redirects back to; must be in Supabase's redirect
# allow-list exactly. Set per environment (localhost in dev, the domain in prod).
MEDSPACE_SITE_URL="https://your-domain"

# Enable only after the initial-assessment migration and access checks pass.
MEDSPACE_PATIENT_ASSESSMENT_ENABLED="false"
# Optional private malware scanner. Without it, documents stay quarantined.
# Every non-loopback scanner requires certificate-verified mutual TLS.
MEDSPACE_CLAMAV_HOST=""
MEDSPACE_CLAMAV_PORT="3310"
MEDSPACE_CLAMAV_TLS="true"
MEDSPACE_CLAMAV_CA_CERT=""
MEDSPACE_CLAMAV_CLIENT_CERT=""
MEDSPACE_CLAMAV_CLIENT_KEY=""
MEDSPACE_REQUIRE_PRIVATE_SCANNER="false"
