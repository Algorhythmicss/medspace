MEDSPACE_SCANNER_BIND=127.0.0.1
MEDSPACE_SCANNER_PORT=3311
MEDSPACE_SCANNER_UPSTREAM_PORT=3310
MEDSPACE_SCANNER_CLIENT_SHA256=REPLACE_WITH_CLIENT_CERTIFICATE_SHA256_FINGERPRINT
MEDSPACE_SCANNER_SERVER_KEY=/etc/medspace-scanner/tls/server.key
MEDSPACE_SCANNER_SERVER_CERT=/etc/medspace-scanner/tls/server.crt
MEDSPACE_SCANNER_CLIENT_CA=/etc/medspace-scanner/tls/client-ca.crt
