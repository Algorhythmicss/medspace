// medSpace information model — memory-first.
// Postgres (Supabase). String pseudo-enums rather than native enums to keep
// migrations simple.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Single-row clinic/doctor settings. Reg number is legally required on every
// electronic prescription (Telemedicine Practice Guidelines 2020).
model Clinic {
  id         String  @id @default("clinic")
  clinicName String
  doctorName String
  regNumber  String
  degrees    String?
  phone      String?
  address    String?
}

model Patient {
  id         String    @id @default(cuid())
  fileNumber Int       @unique // short human id — the "barcode" answer: instant lookup key
  name       String
  phone      String?
  sex        String? // M | F | O
  dob        DateTime?
  ageYears   Int? // fallback when DOB unknown (common in Indian OPD)
  address    String?
  abhaId     String?
  stickyNote String? // durable context: language, caregiver, temperament

  // Whether the patient has actually opened the plan link the doctor sent.
  // Engagement — not messaging — is the binding constraint in the field
  // (SPRINT India: 17% acknowledged receipt; 99DOTS: 33% ever used it), so a
  // pilot has to measure opens or it learns nothing.
  planFirstOpenedAt DateTime?
  planLastOpenedAt  DateTime?
  planOpenCount     Int       @default(0)

  // The other half of the same question: how often the doctor handed the link
  // over. Recorded when the WhatsApp/copy button is pressed — which means it
  // counts "opened WhatsApp with the message ready", not a confirmed delivery.
  // Good enough to tell "never sent" from "sent twice and ignored", which is
  // the distinction that changes what the doctor does next.
  planSharedAt   DateTime?
  planShareCount Int       @default(0)

  // Bumping this invalidates every plan link already sent for this patient —
  // the one "cut this person off" primitive. The token carries the version it
  // was minted at (`v`); the patient page rejects any token whose `v` no longer
  // matches. Needed because a mistyped reception phone number puts a live,
  // weeks-long credential to a medical record in a stranger's WhatsApp, and the
  // only prior remedy was rotating the shared secret — which breaks everyone.
  // Checked on a page that already loads the patient, so it costs no query.
  linkVersion Int @default(1)

  conditions   Condition[]
  allergies    Allergy[]
  visits       Visit[]
  observations Observation[]
  reports      Report[]
  tasks        CarePlanTask[]
  access       PatientAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([name])
}

// Problem list — the spine of the memory card.
model Condition {
  id        String    @id @default(cuid())
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId String
  name      String // "Type 2 Diabetes", "Hypertension"
  status    String    @default("active") // active | resolved
  since     DateTime?
  notes     String?
  createdAt DateTime  @default(now())

  @@index([patientId, status])
}

model Allergy {
  id        String  @id @default(cuid())
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId String
  substance String
  reaction  String?

  @@index([patientId])
}

model Visit {
  id           String    @id @default(cuid())
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId    String
  visitDate    DateTime  @default(now())
  complaint    String? // presenting complaint
  diagnosis    String?
  clinicalNote String?
  followUpDate DateTime? // drives the follow-up loop

  prescription Prescription?
  observations Observation[]
  tasks        CarePlanTask[]

  createdAt DateTime @default(now())

  @@index([patientId, visitDate])
  @@index([followUpDate])
}

model Prescription {
  id        String             @id @default(cuid())
  visit     Visit              @relation(fields: [visitId], references: [id], onDelete: Cascade)
  visitId   String             @unique
  advice    String? // non-drug advice printed on Rx
  items     PrescriptionItem[]
  createdAt DateTime           @default(now())
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  prescriptionId String
  sortOrder      Int          @default(0)
  drugName       String // "Tab Metformin 500mg"
  frequency      String // "1-0-1" | "OD" | "BD" | "SOS"
  duration       String? // "30 days" | "5 days"
  instructions   String? // "after food"
}

// Structured measurements — clinic vitals and lab values. Trend source.
model Observation {
  id         String   @id @default(cuid())
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId  String
  visit      Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  visitId    String?
  type       String // BP_SYS | BP_DIA | PULSE | WEIGHT | HBA1C | FBS | PPBS | CREATININE | LDL | TSH ...
  value      Float
  unit       String?
  measuredAt DateTime @default(now())
  source     String   @default("clinic") // clinic | lab | patient

  @@index([patientId, type, measuredAt])
}

// Foreign-born documents (lab PDFs, outside Rx) — the "layer" half of the model.
model Report {
  id         String   @id @default(cuid())
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId  String
  title      String
  kind       String   @default("lab") // lab | imaging | outside_rx | other
  reportDate DateTime @default(now())
  summary    String? // human/AI summary; source of memory-card lines later

  // Attachments live in the database, not on disk: serverless hosting has no
  // persistent filesystem, and this keeps files behind the same auth gate as
  // the rest of the record instead of on a public URL.
  fileName String?
  fileMime String?
  fileData Bytes?

  @@index([patientId, reportDate])
}

// The executable half of continuity: what should happen between visits.
model CarePlanTask {
  id          String    @id @default(cuid())
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId   String
  visit       Visit?    @relation(fields: [visitId], references: [id], onDelete: SetNull)
  visitId     String?
  kind        String // FOLLOW_UP | LAB_TEST | OTHER
  title       String // "HbA1c + lipid profile", "Review BP in 2 weeks"
  dueDate     DateTime?
  status      String    @default("pending") // pending | done | cancelled
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([patientId, status])
  @@index([status, dueDate])
}

// Seed formulary for autosuggest; also learns the doctor's habits via useCount.
model Drug {
  id                  String  @id @default(cuid())
  name                String  @unique // "Tab Metformin 500mg"
  defaultFrequency    String?
  defaultDuration     String?
  defaultInstructions String?
  useCount            Int     @default(0)
}

// What the WhatsApp link leaves behind — a durable patient identity so the app
// is something people return to, not a fresh link every visit.
//
// The link proves identity once (the doctor sent it to the number in the chart)
// and this row turns that into a lasting one via Google. One identity → MANY
// patients, on purpose: one phone and one Google account per household is normal
// here, so a mother must reach her plan and her son's from the same account.
// patientId is inside the unique key, so a repeat bind is idempotent without the
// mapping ever becoming exclusive.
//
// providerUserId is the SUPABASE user id (stable), never the email — Google
// Workspace addresses get reassigned to new people with a new id, and email is
// mutable; email is stored only so the doctor can recognise the account, and is
// joined on by nothing.
//
// status starts "pending". A binding is created by whoever holds the plan link,
// and a plan link is forwardable, so a Google account only resolves to a patient
// on a *return* visit once the doctor has confirmed it on the chart.
model PatientAccess {
  id             String    @id @default(cuid())
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId      String
  provider       String    @default("google")
  providerUserId String
  email          String?
  status         String    @default("pending") // pending | active | revoked
  boundAt        DateTime  @default(now())
  boundVia       String    @default("plan_link") // plan_link | doctor
  confirmedAt    DateTime?
  lastUsedAt     DateTime?

  @@unique([provider, providerUserId, patientId])
  @@index([patientId, status])
}

// Failed passcode attempts, for throttling /login. The clinic passcode is a
// short numeric PIN typed once a morning; without a limiter an unthrottled POST
// walks the whole keyspace in under a minute and every chart falls. `key` is a
// salted hash of the client IP, never the raw address.
model LoginAttempt {
  id       String   @id @default(cuid())
  key      String
  failedAt DateTime @default(now())

  @@index([key, failedAt])
}
