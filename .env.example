# Postgres connection string (Supabase → Project Settings → Database → Connection string → URI).
# Use the pooled connection (port 6543) for serverless.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Clinic passcode gate
MEDSPACE_PASSCODE="choose-a-passcode"
MEDSPACE_SESSION_SECRET="64-hex-chars-from-openssl-rand-hex-32"

# Signs the patient links sent over WhatsApp (openssl rand -hex 32)
MEDSPACE_PATIENT_LINK_SECRET="64-hex-chars"
